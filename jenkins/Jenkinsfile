pipeline {
    agent any

    environment {
        DOCKER_HUB_CREDENTIALS_ID = 'dockerhub-creds'
        DOCKER_IMAGE = 'komalpreet1703/task-manager'
        DOCKER_TAG = "build-${env.BUILD_NUMBER}"
        SSH_KEY_CREDENTIALS_ID = 'aws-ssh-key'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {

                dir('docker') {

                    bat "docker build -f Dockerfile -t ${DOCKER_IMAGE}:${DOCKER_TAG} .."
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: DOCKER_HUB_CREDENTIALS_ID,
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {

                    bat 'docker login -u "%DOCKER_USER%" -p "%DOCKER_PASS%"'

                    bat "docker push ${DOCKER_IMAGE}:${DOCKER_TAG}"

                    bat "docker tag ${DOCKER_IMAGE}:${DOCKER_TAG} ${DOCKER_IMAGE}:latest"

                    bat "docker push ${DOCKER_IMAGE}:latest"
                }
            }
        }

        stage('Deploy Application (Remote SSH)') {
            steps {

                echo "Starting Application Deployment to K3s..."

                // Update image tag dynamically
                bat """
                    powershell -Command "(Get-Content k8s/deployment.yaml) -replace 'image: komalpreet1703/task-manager:latest', 'image: ${DOCKER_IMAGE}:${DOCKER_TAG}' | Set-Content k8s/deployment.yaml"
                """

                script {

                    // Fetch EC2 public IP
                    def EC2_IP = ""

                    // Fetch the EC2 IP dynamically using AWS CLI
                    EC2_IP = bat(
                        script: '@aws ec2 describe-instances --region us-east-1 --filters "Name=tag:Name,Values=Task-Manager-K3s-Node" "Name=instance-state-name,Values=running" --query "Reservations[*].Instances[*].PublicIpAddress" --output text',
                        returnStdout: true
                    ).trim()

                    echo "Deploying to EC2 IP: ${EC2_IP}"

                    withCredentials([
                        sshUserPrivateKey(
                            credentialsId: SSH_KEY_CREDENTIALS_ID,
                            keyFileVariable: 'SSH_KEY'
                        )
                    ]) {

                        def sshOpts = '-o StrictHostKeyChecking=no'

                        // Fix Windows OpenSSH permissions
                        bat """
                            icacls "%SSH_KEY%" /inheritance:r
                            icacls "%SSH_KEY%" /grant:r "Administrators:R"
                        """

                        // Copy Kubernetes manifests
                        bat """
                            scp -i "%SSH_KEY%" ${sshOpts} -r k8s ubuntu@${EC2_IP}:/home/ubuntu/
                        """

                        // Check cluster status
                        bat """
                            ssh -i "%SSH_KEY%" ${sshOpts} ubuntu@${EC2_IP} "kubectl get nodes"
                        """

                        bat """
                            ssh -i "%SSH_KEY%" ${sshOpts} ubuntu@${EC2_IP} "kubectl get pods -A"
                        """

                        // Deploy app
                        bat """
                            ssh -i "%SSH_KEY%" ${sshOpts} ubuntu@${EC2_IP} "kubectl apply -f /home/ubuntu/k8s/"
                        """

                        // Verify deployments
                        bat """
                            ssh -i "%SSH_KEY%" ${sshOpts} ubuntu@${EC2_IP} "kubectl get pods -A"
                        """

                        bat """
                            ssh -i "%SSH_KEY%" ${sshOpts} ubuntu@${EC2_IP} "kubectl get svc -A"
                        """
                    }
                }
            }
        }
    }
}