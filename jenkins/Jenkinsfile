pipeline {
    agent any

    environment {
        DOCKER_HUB_CREDENTIALS_ID = 'dockerhub-creds'
        DOCKER_IMAGE = 'komalpreet1703/task-manager'
        DOCKER_TAG = "build-${env.BUILD_NUMBER}"
        SSH_KEY_CREDENTIALS_ID = 'aws-ssh-key'
        AWS_CREDS_ID = 'aws-creds'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Infrastructure Provisioning (Terraform Apply)') {
            steps {
                dir('terraform') {

                    withCredentials([
                        aws(
                            credentialsId: AWS_CREDS_ID,
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]) {

                        bat 'terraform init'
                        bat 'terraform apply -auto-approve'
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('docker') {

                    bat "docker build -f Dockerfile -t ${DOCKER_IMAGE}:${DOCKER_TAG} .."

                }
            }
        }

        stage('Push to Docker Hub') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: DOCKER_HUB_CREDENTIALS_ID,
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {

                    bat 'docker login -u "%DOCKER_USER%" -p "%DOCKER_PASS%"'

                    bat "docker push ${DOCKER_IMAGE}:${DOCKER_TAG}"

                    bat "docker tag ${DOCKER_IMAGE}:${DOCKER_TAG} ${DOCKER_IMAGE}:latest"

                    bat "docker push ${DOCKER_IMAGE}:latest"
                }
            }
        }

        stage('Deploy Application (Remote SSH)') {
            steps {

                echo "Waiting 3 minutes for k3s cluster to initialize on EC2..."

                sleep time: 180, unit: 'SECONDS'

                // Replace image tag dynamically
                bat """
                    powershell -Command "(Get-Content k8s/deployment.yaml) -replace 'image: komalpreet1703/task-manager:latest', 'image: ${DOCKER_IMAGE}:${DOCKER_TAG}' | Set-Content k8s/deployment.yaml"
                """

                script {

                    // Fetch EC2 public IP
                    def EC2_IP = ""

                    dir('terraform') {

                        EC2_IP = bat(
                            script: '@terraform output -raw instance_public_ip',
                            returnStdout: true
                        ).trim()
                    }

                    echo "Deploying to EC2 IP: ${EC2_IP}"

                    // Inject SSH key directly
                    withCredentials([
                        sshUserPrivateKey(
                            credentialsId: SSH_KEY_CREDENTIALS_ID,
                            keyFileVariable: 'SSH_KEY'
                        )
                    ]) {

                        def sshOpts = '-o StrictHostKeyChecking=no'

                        // Copy files
                        bat """
                            scp -i "%SSH_KEY%" ${sshOpts} -r k8s monitoring ubuntu@${EC2_IP}:/home/ubuntu/
                        """

                        // Deploy Kubernetes manifests
                        bat """
                            ssh -i "%SSH_KEY%" ${sshOpts} ubuntu@${EC2_IP} "kubectl apply -f /home/ubuntu/k8s/"
                        """

                        // Deploy monitoring stack
                        bat """
                            ssh -i "%SSH_KEY%" ${sshOpts} ubuntu@${EC2_IP} "kubectl apply -f /home/ubuntu/monitoring/"
                        """
                    }
                }
            }
        }

        stage('Infrastructure Teardown (Terraform Destroy)') {
            steps {

                input message: 'Are you sure you want to destroy the AWS Infrastructure? This will delete the EC2 instance.', ok: 'Yes, Destroy'

                dir('terraform') {

                    withCredentials([
                        aws(
                            credentialsId: AWS_CREDS_ID,
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]) {

                        bat 'terraform destroy -auto-approve'
                    }
                }
            }
        }
    }
}